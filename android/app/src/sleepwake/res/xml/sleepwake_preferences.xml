<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Night loop">
        <SwitchPreferenceCompat
            android:key="never_wake_early"
            android:title="Data only: never wake early"
            android:summary="Off (normal): wake at light sleep inside the window, at the latest at its end. On: wake only at the target time." />
        <EditTextPreference
            android:key="fetch_interval_min"
            android:title="Fetch interval (minutes)"
            android:summary="How often the watch is read during a night. Minimum 1. Default 5."
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="monitor_wake_at"
            android:title="Monitor-only wakes at"
            android:entries="@array/sw_monitor_wake_names"
            android:entryValues="@array/sw_monitor_wake_values"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="fallback"
            android:title="Fallback when the watch is unavailable"
            android:entries="@array/sw_fallback_names"
            android:entryValues="@array/sw_fallback_values"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Detector">
        <Preference android:key="detector_info" android:title="Downloaded detector config" android:selectable="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Built-in heuristic (used when no config was downloaded)">
        <EditTextPreference android:key="h_recent_min" android:title="Recent window (minutes)" app:useSimpleSummaryProvider="true" />
        <EditTextPreference android:key="h_hr_delta" android:title="HR above baseline (bpm)" app:useSimpleSummaryProvider="true" />
        <EditTextPreference android:key="h_base_pct" android:title="Baseline percentile of HR" app:useSimpleSummaryProvider="true" />
        <EditTextPreference android:key="h_onset_quiet_min" android:title="Quiet minutes that mark sleep onset" app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:key="cat_sync" android:title="Sync to webapp">
        <SwitchPreferenceCompat android:key="sync_enabled" android:title="Enable sync" />
        <EditTextPreference
            android:key="sync_base_url"
            android:title="Base URL (https)"
            android:dialogMessage="For example https://gadget.peppasoft.com"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:key="api_token"
            android:title="API token"
            android:summary="Stored encrypted. Create it on the webapp Settings page." />
        <EditTextPreference
            android:key="sync_interval_min"
            android:title="Sync interval (minutes, min 15)"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat android:key="sync_wifi_only" android:title="Sync only on Wi-Fi" />
        <Preference android:key="sync_test" android:title="Test connection" />
        <Preference android:key="sync_now" android:title="Sync now" />
        <Preference android:key="sync_status" android:title="Last sync" android:selectable="false" />
    </PreferenceCategory>
</PreferenceScreen>
